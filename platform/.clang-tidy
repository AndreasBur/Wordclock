# What a target needs beside src/: its registers, its timers, its interrupt
# routines. Two checks read wrong here, as in examples/:
#
# readability-magic-numbers: a prescaler, a pin, a value of a register read
# better as the numbers the datasheet gives than behind names used once.
# cppcoreguidelines-avoid-non-const-global-variables: an interrupt routine
# takes no argument, and shares its state with the loop through a global.
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables
