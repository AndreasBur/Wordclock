/**     \file       limits
 *      \brief      numeric_limits for a toolchain that ships no libstdc++, see stl/type_traits
 *
 *      \details    Only max() and min() are provided, because that is all the core asks for.
 *
 *                  Both are constexpr, which the vendored xmega STL's were not: the core
 *                  calls them from constant expressions and that copy fails to compile there.
 *
 *                  min() keeps the standard's meaning for floating-point types, the smallest
 *                  positive normal rather than the most negative value. Anything else would
 *                  be a quiet disagreement with the libstdc++ the other backends are built
 *                  against, and a backend that answers a command differently from the
 *                  simulator it was tested on is worse than one that reproduces a surprise
 *                  faithfully.
 *
 *                  The floating-point figures come from the compiler's own __FLT_MAX__ and
 *                  friends rather than from literals, so a build with -mdouble=64 gets the
 *                  limits of the double it actually has.
 *
******************************************************************************************************************************************************/
#ifndef _STL_LIMITS_
#define _STL_LIMITS_

#include "type_traits"

namespace std {

/* The integral case, worked out from the type itself: everything the core measures against
   is an integer of some width, and deriving the bound beats one specialisation per type. */
template<class T> struct numeric_limits {
  private:
    static constexpr bool IsSigned{T(-1) < T(0)};
    static constexpr unsigned Bits{sizeof(T) * 8u};

  public:
    static constexpr bool is_signed{IsSigned};

    static constexpr T max() {
        return IsSigned ? static_cast<T>(~(static_cast<T>(1) << (Bits - 1u))) : static_cast<T>(~static_cast<T>(0));
    }

    static constexpr T min() {
        return IsSigned ? static_cast<T>(static_cast<T>(1) << (Bits - 1u)) : static_cast<T>(0);
    }
};

template<> struct numeric_limits<float> {
    static constexpr bool is_signed{true};
    static constexpr float max() { return __FLT_MAX__; }
    static constexpr float min() { return __FLT_MIN__; }
    static constexpr float lowest() { return -__FLT_MAX__; }
};

template<> struct numeric_limits<double> {
    static constexpr bool is_signed{true};
    static constexpr double max() { return __DBL_MAX__; }
    static constexpr double min() { return __DBL_MIN__; }
    static constexpr double lowest() { return -__DBL_MAX__; }
};

template<> struct numeric_limits<long double> {
    static constexpr bool is_signed{true};
    static constexpr long double max() { return __LDBL_MAX__; }
    static constexpr long double min() { return __LDBL_MIN__; }
    static constexpr long double lowest() { return -__LDBL_MAX__; }
};

} // namespace std

#endif // _STL_LIMITS_

