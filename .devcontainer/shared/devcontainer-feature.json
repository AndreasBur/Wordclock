{
    "id": "shared",
    "version": "1.4.0",
    "name": "Wordclock shared editor configuration",
    "description": "Extensions, CMake settings, the toolchain check, package caches, logins and shell history shared by every devcontainer.json variant.",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "EditorConfig.EditorConfig",
                "eamodio.gitlens",
                "cschlosser.doxdocgen",
                "openai.chatgpt",
                "anthropic.claude-code"
            ],
            "settings": {
                "cmake.configureOnOpen": true,
                "cmake.generator": "Ninja",
                "cmake.configureSettings": {
                    "PLATFORM": "simulator",
                    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
                },
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--compile-commands-dir=${workspaceFolder}/build"
                ],
                "doxdocgen.c.triggerSequence": "/*!",
                "doxdocgen.c.firstLine": "/*!",
                "doxdocgen.c.commentPrefix": " * ",
                "doxdocgen.c.lastLine": " */",
                "doxdocgen.generic.briefTemplate": "\\brief {text}",
                "doxdocgen.generic.paramTemplate": "\\param[in] {param} ",
                "doxdocgen.cpp.tparamTemplate": "\\tparam {param} ",
                "doxdocgen.generic.returnTemplate": "\\return ",
                "doxdocgen.generic.includeTypeAtReturn": false,
                "doxdocgen.generic.order": ["brief", "empty", "tparam", "param", "return"]
            }
        }
    },
    "containerEnv": {
        "GH_HOST": "github.com",
        // The cache volume and the project environment live on different file systems.
        "UV_LINK_MODE": "copy",
        // Keep Claude's settings and login together in the volume below.
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        // Save after each command, including when a rebuild closes the terminal.
        "HISTFILE": "/home/vscode/.commandhistory/.bash_history",
        "PROMPT_COMMAND": "history -a"
    },
    "postCreateCommand": "wordclock-tool-env && wordclock-toolchain-check",
    // git signs in to GitHub through gh, whose login is in the volume below, rather than
    // through VS Code's helper, which opens a window on the host. On every attach, after VS Code
    // has copied the host's .gitconfig in; nothing without a login.
    "postAttachCommand": "gh auth status --hostname github.com >/dev/null 2>&1 && gh auth setup-git --hostname github.com || true",
    "mounts": [
        {
            "source": "wordclock-platformio",
            "target": "/home/vscode/.platformio",
            "type": "volume"
        },
        {
            "source": "wordclock-uv-cache",
            "target": "/home/vscode/.cache/uv",
            "type": "volume"
        },
        {
            "source": "wordclock-codex",
            "target": "/home/vscode/.codex",
            "type": "volume"
        },
        {
            "source": "wordclock-claude",
            "target": "/home/vscode/.claude",
            "type": "volume"
        },
        {
            "source": "wordclock-gh",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        },
        {
            "source": "wordclock-history",
            "target": "/home/vscode/.commandhistory",
            "type": "volume"
        }
    ],
    "postStartCommand": "platformio-trust-store"
}
