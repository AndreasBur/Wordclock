{
    "id": "shared",
    "version": "1.3.0",
    "name": "Wordclock shared editor configuration",
    "description": "Extensions, CMake settings, the toolchain check and the PlatformIO package cache shared by every devcontainer.json variant.",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "EditorConfig.EditorConfig",
                "eamodio.gitlens",
                "cschlosser.doxdocgen",
                "openai.chatgpt"
            ],
            "settings": {
                "cmake.configureOnOpen": true,
                "cmake.generator": "Ninja",
                "cmake.configureSettings": {
                    "PLATFORM": "simulator",
                    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
                },
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--compile-commands-dir=${workspaceFolder}/build"
                ],
                "doxdocgen.c.triggerSequence": "/*!",
                "doxdocgen.c.firstLine": "/*!",
                "doxdocgen.c.commentPrefix": " * ",
                "doxdocgen.c.lastLine": " */",
                "doxdocgen.generic.briefTemplate": "\\brief {text}",
                "doxdocgen.generic.paramTemplate": "\\param[in] {param} ",
                "doxdocgen.cpp.tparamTemplate": "\\tparam {param} ",
                "doxdocgen.generic.returnTemplate": "\\return ",
                "doxdocgen.generic.includeTypeAtReturn": false,
                "doxdocgen.generic.order": ["brief", "empty", "tparam", "param", "return"]
            }
        }
    },
    "containerEnv": {
        "GH_HOST": "github.com"
    },
    "postCreateCommand": "wordclock-tool-env && wordclock-toolchain-check",
    "mounts": [
        {
            "source": "wordclock-platformio",
            "target": "/home/vscode/.platformio",
            "type": "volume"
        },
        {
            "source": "wordclock-codex",
            "target": "/home/vscode/.codex",
            "type": "volume"
        },
        {
            "source": "wordclock-gh",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        }
    ],
    "postStartCommand": "platformio-trust-store"
}
