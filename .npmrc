# The public registry, named here so that a machine whose own npm configuration points
# elsewhere - a company mirror - still writes a package-lock.json that CI can resolve.
registry=https://registry.npmjs.org/
# Exact versions in package.json, as pyproject.toml pins its tools; Dependabot moves them.
save-exact=true
# None of the linters needs an install script, and a dependency that ships one does not get to
# run it on a developer's machine because a lockfile changed.
ignore-scripts=true
