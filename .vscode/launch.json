{
    // Launch configuration for the Wordclock simulator (wxWidgets/GTK):
    // F5 starts with GDB; Ctrl+F5 runs the same binary without a debugger.
    // The hardware target is built with the AVR toolchain and is not included here.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Simulator (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Wordclock",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: build",
            "setupCommands": [
                {
                    "description": "Pretty-printing für gdb aktivieren",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
