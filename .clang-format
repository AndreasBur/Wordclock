---
BasedOnStyle: Google
# const right of what it qualifies: char const*, Status const&. Google
# encourages const first but does not require it, and asks to be consistent with the code
# around; this is the one place the library departs from its preference. volatile moves
# with it. clang-format --dry-run in tools/lint.sh fails on a const on the left.
QualifierAlignment: Right
# A test of RingBuffer.h is RingBufferTest.cpp (docs/Testing.md TS-5), and includes the header
# it tests first, as a source does its own. Google's regex knows only the endings _test and
# _unittest; Test is added to them.
IncludeIsMainRegex: '(Test|[-_](test|unittest))?$'
# Wordclock's own: 100 columns rather than Google's 80. It was written to 100 before it came onto
# the template, more than 10 000 of its lines are longer than 80, and at 80 every comment would
# be wrapped anew and the tables of the fonts and the words broken into two lines a row.
# CPPLINT.cfg says the same with linelength.
ColumnLimit: 100
# Wordclock's own: wxWidgets' event tables, BEGIN_EVENT_TABLE() to END_EVENT_TABLE(), are a
# block of macros, not calls; without these clang-format joins the entries into one statement,
# and Doxygen then reads them as declarations of the file.
MacroBlockBegin: '^(wx)?BEGIN_EVENT_TABLE$'
MacroBlockEnd: '^(wx)?END_EVENT_TABLE$'
# Not Google's, and not only Wordclock's: a NOLINT comment is never wrapped. Wrapped, the
# list of a NOLINTBEGIN continues on a line clang-tidy does not read, and the block is unmatched.
CommentPragmas: '^ (IWYU pragma:|NOLINT)'
