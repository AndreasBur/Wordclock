# What a command line is made of, for libFuzzer's -dict: the option letters with their dash,
# the separators and the numbers at the edges of the types the parameters are parsed into.
# Mutating a line by these pieces reaches a parser's option far sooner than by single bytes.
"-A"
"-B"
"-D"
"-E"
"-F"
"-G"
"-H"
"-I"
"-M"
"-N"
"-P"
"-R"
"-S"
"-T"
"-V"
"-Y"
" "
"\x0a"
"0"
"-1"
"127"
"128"
"255"
"256"
"32767"
"65535"
"65536"
"4294967295"
"4294967296"
"99999999999999999999"
